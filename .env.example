# ============================================================
#  Competitor Monitor - settings
#  Copy this file to ".env" and fill in the real values.
#  The .env file is never committed and never printed in logs.
# ============================================================

# --- Who this report is for -------------------------------
# Used in the Google Sheet title: "<CLIENT_NAME> - Competitor Intel"
CLIENT_NAME=

# --- Where alerts go --------------------------------------
ALERT_EMAIL_TO=

# --- Proxy (paste the details your proxy provider gave you) -
# Example: PROXY_SERVER=http://gate.smartproxy.com:7000
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=
# Set to false to scrape from your own IP address instead.
PROXY_ENABLED=true

# --- Google Sheets ----------------------------------------
# Path to the service-account key file you downloaded.
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
# Leave blank the first time. After the first run the script prints the
# sheet's ID - paste it here so it always reuses the same sheet.
GOOGLE_SHEET_ID=

# --- Email (Gmail) ----------------------------------------
# SMTP_PASSWORD must be a 16-character Google "app password",
# NOT your normal Gmail password. See README.md step 4.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Scraping behaviour -----------------------------------
# Seconds to wait between products. Higher = gentler on their servers.
REQUEST_DELAY_SECONDS=6
# How long to wait for one page before giving up (milliseconds).
PAGE_TIMEOUT_MS=45000
# How many times to retry a page that fails.
MAX_RETRIES=2
# Run the browser invisibly. Set to false to watch it work (for debugging).
HEADLESS=true
# Only turn this on if a site is blocking you behind a Cloudflare check.
# It is slower, and it logs a harmless error on sites that do not use Cloudflare.
SOLVE_CLOUDFLARE=false

# ---- What counts as an alert --------------------------------------------
# Price drops and stock-outs always raise an alert.
# Back-in-stock is useful but noisier, so it is off unless you turn it on.
ALERT_ON_BACK_IN_STOCK=false

# ---- Speed ----------------------------------------------------------------
# Try a fast plain request first and only start the browser when a page
# needs it. Set to false to use the stealth browser for every page (slower,
# but closest to a real visitor).
FAST_MODE=true
HTTP_TIMEOUT_SECONDS=20
# Wait for the page to stop making network requests before reading it.
# Shops with analytics or chat widgets may never stop, so this can cost the
# whole timeout per page. Turn on only for a site whose prices load late.
NETWORK_IDLE=false
